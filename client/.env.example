# Production Colyseus backend URL. Vite bakes this in at build time.
# Leave unset locally; getColyseusEndpoint() falls back to same-origin and
# Vite proxies /matchmake + /ws to localhost:2567 (see vite.config.ts).
# Vercel: Production -> https://orbital-breach.onrender.com,
# Preview (staging) -> https://orbital-breach-server-staging.onrender.com
VITE_COLYSEUS_ENDPOINT=https://orbital-breach.onrender.com
