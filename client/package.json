{
  "name": "orbital-breach-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "graph:build": "node ../scripts/graphify.mjs build",
    "graph:update": "node ../scripts/graphify.mjs update",
    "graph:query": "node ../scripts/graphify.mjs query",
    "graph:path": "node ../scripts/graphify.mjs path",
    "graph:explain": "node ../scripts/graphify.mjs explain",
    "graph:status": "node ../scripts/graphify.mjs status",
    "graph:check": "node ../scripts/graphify.mjs check",
    "graph:cluster": "node ../scripts/graphify.mjs cluster",
    "graph:watch": "node ../scripts/graphify.mjs watch"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.40",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "qrcode": "^1.5.4",
    "three": "^0.179.1",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "8.5.29",
    "nanoid": "3.3.19"
  }
}
