{
  "description": "Optional, fast awareness of Orbital Breach's local Graphify graph.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e 'const cp=require(\"node:child_process\"),p=require(\"node:path\");const r=cp.execFileSync(\"git\",[\"rev-parse\",\"--show-toplevel\"],{encoding:\"utf8\"}).trim();require(p.join(r,\"scripts\",\"graphify-session-start.cjs\"));'",
            "commandWindows": "node -e \"const cp=require('node:child_process'),p=require('node:path');const r=cp.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();require(p.join(r,'scripts','graphify-session-start.cjs'));\"",
            "timeout": 3,
            "statusMessage": "Checking local knowledge graph",
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
